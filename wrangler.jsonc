{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hairouna-business-solutions",
  "compatibility_date": "2026-09-29",
  "previews": {},
  "routes": [
    { "pattern": "hairounaholdingsinc.com/*", "zone_name": "hairounaholdingsinc.com" },
    { "pattern": "www.hairounaholdingsinc.com/*", "zone_name": "hairounaholdingsinc.com" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
